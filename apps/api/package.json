{
  "name": "@weather-activity-planner/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "npm run codegen && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "npm run codegen && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run codegen && vitest run",
    "codegen": "node --import tsx scripts/generateGraphQL.mjs && prettier --write src/graphql/generated.ts"
  },
  "dependencies": {
    "graphql": "16.14.2",
    "graphql-yoga": "5.24.6",
    "luxon": "3.7.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@graphql-codegen/core": "6.2.2",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-resolvers": "6.1.1",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.12"
  }
}
